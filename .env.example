# saasy-edge environment
# Copy to .env for local development. The migrate-up/migrate-down make targets
# source this file for database credentials.

PORT=8080
GRPC_PORT=9090

DB_HOST=localhost
DB_PORT=5432
DB_NAME=saasy-edge-db
DB_USER=
DB_PASSWORD=

# Web client origin, for CORS
WEB_URL=http://localhost:5173
